<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cubilete1"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginHorizontal="10dp"
            android:contentDescription="@string/ivCubilete1"
            android:src="@drawable/cubilete" />

        <ImageView
            android:id="@+id/cubilete2"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginHorizontal="10dp"
            android:contentDescription="@string/ivCubilete2"
            android:src="@drawable/cubilete" />

        <ImageView
            android:id="@+id/cubilete3"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginHorizontal="10dp"
            android:contentDescription="@string/ivCubilete3"
            android:src="@drawable/cubilete" />
    </LinearLayout>

    <Button
        android:id="@+id/bStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textAllCaps="false"
        android:text="@string/bStart" />

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textSize="16sp" />
</LinearLayout>